# Contact form email delivery (optional until you're ready to wire it up).
# Without these set, the /api/contact route returns 503 and the form shows a
# "email isn't connected yet" message with a mailto: link to your address —
# so the site stays fully functional in the meantime.

# 1. Create a free account at https://resend.com and make an API key.
RESEND_API_KEY=

# 2. Sender address. For first tests you can leave this unset and the route
#    uses Resend's shared "onboarding@resend.dev" sender. For production,
#    verify your own domain in Resend and set a from-address on that domain,
#    e.g. "Dinesh Sharma <hello@yourdomain.com>".
CONTACT_FROM=

# Messages are always delivered to the address in data/site.ts (site.email).
